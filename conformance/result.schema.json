{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AlexMercedCoder/agentic-graph-spec/v1.0.1/conformance/result.schema.json",
  "title": "AGS Conformance Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ags_version", "maintenance_release", "implementation", "implementation_version", "level", "fixture_revision", "passed", "failed", "generated_at"],
  "properties": {
    "schema": {"const": "ags.conformance-result.v1"},
    "ags_version": {"const": "1.0"},
    "maintenance_release": {"const": "1.0.1"},
    "implementation": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "level": {"type": "integer", "minimum": 0, "maximum": 3},
    "fixture_revision": {"type": "string", "minLength": 7},
    "passed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
